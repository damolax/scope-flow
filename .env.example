# Server-only Supabase access
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_OR_SECRET_KEY

# Public Supabase Auth configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Long random server-side cookie signing secret
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Protected platform administrator
PLATFORM_ADMIN_EMAIL=oyekunleolalekan3168@gmail.com

# Optional automatic client email delivery through Resend.
# When omitted, ScopeFlow safely opens the owner's email app with a prepared message.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_KEY
EMAIL_FROM=ScopeFlow <updates@your-verified-domain.com>

